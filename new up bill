<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StoreBill — Stock &amp; Billing</title>
<style>
  :root{
    --paper:#FAF5E9; --paper-raised:#FFFFFF; --ink:#2B241A; --ink-soft:#6B6153;
    --line:#E1D6BE; --turmeric:#C98A2B; --turmeric-deep:#A8701C;
    --brick:#A6432A; --brick-deep:#863526; --teal:#2F5D57; --teal-deep:#234641;
    --radius:10px; --shadow:0 1px 2px rgba(43,36,26,.06), 0 8px 24px rgba(43,36,26,.06);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;background:var(--paper);color:var(--ink);
    font-family:-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.5;}
  h1,h2,h3,.display{font-family:Georgia,"Times New Roman",serif;font-weight:700;color:var(--ink);margin:0;}
  .mono{font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;}
  a{color:inherit;}
  button{font-family:inherit;}

  .topbar{display:flex;align-items:center;justify-content:space-between;padding:14px 24px;
    background:var(--paper-raised);border-bottom:2px solid var(--ink);}
  .brand{display:flex;align-items:center;gap:10px;}
  .brand .mark{width:34px;height:34px;border-radius:50%;background:var(--turmeric);color:#fff;
    display:inline-flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-weight:700;font-size:16px;flex-shrink:0;}
  .brand h1{font-size:19px;}
  .brand .tag{font-size:11px;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.08em;}
  .who{display:flex;align-items:center;gap:12px;font-size:13px;color:var(--ink-soft);}
  .role-chip{font-size:10px;text-transform:uppercase;letter-spacing:.06em;padding:3px 9px;border-radius:999px;font-weight:700;}
  .role-chip.admin{background:var(--brick);color:#fff;} .role-chip.labor{background:var(--teal);color:#fff;}
  .sync{font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;white-space:nowrap;}
  .sync.ok{background:#E4EFE9;color:var(--teal-deep);}
  .sync.bad{background:#F5E0DA;color:var(--brick-deep);}
  .sync.local{background:#FBEBD3;color:var(--turmeric-deep);}

  .shell{display:flex;min-height:calc(100vh - 62px);}
  .sidebar{width:210px;background:var(--paper-raised);border-right:1px solid var(--line);padding:18px 12px;flex-shrink:0;}
  .sidebar button.navlink{display:block;width:100%;text-align:left;padding:10px 12px;border-radius:8px;border:none;background:none;
    color:var(--ink-soft);font-weight:500;font-size:14px;margin-bottom:2px;cursor:pointer;}
  .sidebar button.navlink.active,.sidebar button.navlink:hover{background:#F1E7D0;color:var(--ink);}
  .sidebar .navsep{margin-top:10px;border-top:1px solid var(--line);padding-top:12px;}
  .main{flex:1;padding:26px 30px;max-width:1150px;}

  .card{background:var(--paper-raised);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:18px;}
  .stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px;}
  .stat-grid .card .label{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-soft);margin-bottom:6px;}
  .stat-grid .card .value{font-family:Georgia,serif;font-size:28px;font-weight:700;}
  .stat-grid .card.warn .value{color:var(--brick);} .stat-grid .card.good .value{color:var(--teal);}

  .btn{display:inline-flex;align-items:center;gap:6px;padding:9px 15px;border-radius:8px;border:1px solid transparent;
    font-weight:600;font-size:13.5px;cursor:pointer;text-decoration:none;background:none;}
  .btn:active{transform:translateY(1px);}
  .btn-primary{background:var(--ink);color:var(--paper);} .btn-primary:hover{background:#3d3325;}
  .btn-outline{background:transparent;border-color:var(--line);color:var(--ink);} .btn-outline:hover{border-color:var(--ink);}
  .btn-danger{background:var(--brick);color:#fff;} .btn-danger:hover{background:var(--brick-deep);}
  .btn-sm{padding:5px 10px;font-size:12px;}
  .btn[disabled]{opacity:.5;cursor:not-allowed;}

  .field{margin-bottom:14px;}
  .field label{display:block;font-size:12.5px;font-weight:700;margin-bottom:5px;}
  .input,input[type=text],input[type=password],input[type=number],select{
    width:100%;padding:9px 11px;border:1px solid var(--line);border-radius:7px;background:var(--paper-raised);
    font-size:14px;font-family:inherit;color:var(--ink);}
  .input:focus,input:focus,select:focus{outline:2px solid var(--turmeric);outline-offset:1px;border-color:var(--turmeric);}
  .checkbox-row{display:flex;align-items:center;gap:8px;}
  .checkbox-row input{width:auto;}
  .helptext{font-size:11.5px;color:var(--ink-soft);margin-top:4px;}
  .errbox{color:var(--brick);font-size:13px;margin:8px 0;}

  table.list{width:100%;border-collapse:collapse;}
  table.list th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-soft);
    padding:9px 10px;border-bottom:2px solid var(--ink);}
  table.list td{padding:11px 10px;border-bottom:1px solid var(--line);font-size:13.5px;vertical-align:middle;}
  table.list tr:hover td{background:#FBF7EA;}
  .badge{font-size:10.5px;font-weight:700;padding:3px 9px;border-radius:999px;text-transform:uppercase;letter-spacing:.04em;}
  .badge.in{background:#E4EFE9;color:var(--teal-deep);} .badge.low{background:#FBEBD3;color:var(--turmeric-deep);}
  .badge.out{background:#F5E0DA;color:var(--brick-deep);}

  .msg{padding:10px 14px;border-radius:8px;margin-bottom:14px;font-size:13.5px;background:#F1E7D0;border-left:4px solid var(--turmeric);}
  .msg.err{background:#F5E0DA;border-left-color:var(--brick);font-weight:600;}

  .auth-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;}
  .auth-card{width:360px;}
  .auth-card h1{font-size:22px;margin:12px 0 2px;}
  .auth-card .sub{color:var(--ink-soft);font-size:13px;margin-bottom:18px;}

  .billing-shell{display:flex;gap:22px;padding:22px 26px;align-items:flex-start;flex-wrap:wrap;}
  .product-pane{flex:1.7;min-width:300px;}
  .search-row{margin-bottom:14px;}
  .search-row input{padding:11px 13px;font-size:14.5px;}
  .product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:11px;}
  .product-tile{background:var(--paper-raised);border:1px solid var(--line);border-radius:var(--radius);padding:13px;
    cursor:pointer;position:relative;}
  .product-tile:hover{border-color:var(--turmeric);}
  .product-tile.disabled{opacity:.45;cursor:not-allowed;}
  .product-tile .name{font-weight:700;margin-bottom:3px;font-size:14px;}
  .product-tile .cat{font-size:10.5px;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.04em;margin-bottom:7px;min-height:12px;}
  .product-tile .price{font-size:14px;color:var(--teal-deep);font-weight:700;}
  .product-tile .stock{font-size:11.5px;color:var(--ink-soft);margin-top:2px;}
  .product-tile .badge{position:absolute;top:9px;right:9px;}

  .receipt-pane{flex:1;min-width:280px;position:sticky;top:20px;}
  .receipt{background:#FFFDF8;border:1px solid var(--line);border-radius:10px 10px 0 0;box-shadow:var(--shadow);padding:18px 18px 8px;}
  .receipt-tear{height:13px;background:linear-gradient(-45deg,var(--paper) 6px,transparent 0) 0 6px,
    linear-gradient(45deg,var(--paper) 6px,#FFFDF8 0) 0 6px;background-size:16px 16px;background-repeat:repeat-x;margin-bottom:14px;}
  .receipt h2{font-size:15px;text-align:center;text-transform:uppercase;letter-spacing:.08em;}
  .receipt .sub-center{text-align:center;font-size:10.5px;color:var(--ink-soft);margin-bottom:12px;}
  .receipt .cust-field{margin-bottom:12px;}
  .receipt-lines{border-top:1px dashed var(--line);border-bottom:1px dashed var(--line);padding:9px 0;margin-bottom:11px;min-height:50px;}
  .receipt-line{display:flex;justify-content:space-between;align-items:center;font-size:12.5px;padding:6px 0;}
  .receipt-line .rl-name{font-weight:700;}
  .receipt-line .rl-meta{color:var(--ink-soft);font-size:11px;}
  .receipt-line .rl-remove{color:var(--brick);cursor:pointer;font-size:12px;margin-left:8px;}
  .receipt-empty{color:var(--ink-soft);font-size:12.5px;text-align:center;padding:10px 0;}
  .receipt-total{display:flex;justify-content:space-between;font-size:17px;font-weight:700;margin-bottom:14px;}
  .stamp-btn{display:block;width:100%;padding:15px;border-radius:999px;border:3px dashed var(--brick);background:transparent;
    color:var(--brick);font-family:Georgia,serif;font-weight:700;font-size:15px;letter-spacing:.1em;text-transform:uppercase;
    cursor:pointer;transform:rotate(-1deg);}
  .stamp-btn:hover{background:var(--brick);color:#fff;}
  .stamp-btn:disabled{opacity:.4;cursor:not-allowed;background:transparent;color:var(--brick);}

  .modal-backdrop{position:fixed;inset:0;background:rgba(43,36,26,.45);display:none;align-items:center;justify-content:center;z-index:50;}
  .modal-backdrop.open{display:flex;}
  .modal{background:var(--paper-raised);border-radius:12px;padding:20px;width:300px;box-shadow:var(--shadow);max-height:92vh;overflow:auto;}
  .modal h3{margin-bottom:12px;}
  .qty-row{display:flex;gap:8px;}
  .qty-row select,.qty-row input{width:auto;}

  /* ---------- print: max 10 items per page, page length fits content ---------- */
  .print-only{display:none;}
  @media print{
    html,body{background:#fff !important;height:auto !important;min-height:0 !important;}
    body > *:not(#printArea){display:none !important;}
    #printArea{display:block !important;position:static;margin:0 auto;}
  }
  #printArea{width:72mm;font-family:"SFMono-Regular",Consolas,"Liberation Mono",monospace;font-size:11.5px;line-height:1.35;color:#000;}
  #printArea .center{text-align:center;}
  #printArea .shop{text-align:center;font-family:Georgia,serif;font-weight:700;font-size:17px;letter-spacing:.06em;text-transform:uppercase;}
  #printArea .sub{text-align:center;font-size:10.5px;}
  #printArea hr{border:none;border-top:1px dashed #555;margin:5px 0;}
  #printArea table{width:100%;border-collapse:collapse;}
  #printArea td{padding:1px 0;font-size:11.5px;vertical-align:top;}
  #printArea td.r{text-align:right;white-space:nowrap;}
  #printArea .item-name{font-weight:700;}
  #printArea .count-pill{display:flex;justify-content:space-between;border:1px solid #000;padding:2px 5px;margin:4px 0;font-weight:700;}
  #printArea .grand{font-size:14px;font-weight:700;}
  .receipt-page{break-after:page;page-break-after:always;}
  .receipt-page:last-child{break-after:auto;page-break-after:auto;}
  .keep-together{break-inside:avoid;page-break-inside:avoid;}

  /* ---------- splash / intro animation (5 seconds) ---------- */
  #splash{position:fixed;inset:0;z-index:9999;background:#2B241A;display:flex;flex-direction:column;align-items:center;justify-content:center;
    transition:opacity .6s ease, visibility .6s ease;}
  #splash.hide{opacity:0;visibility:hidden;}
  #splash svg{width:132px;height:132px;overflow:visible;}
  #splash .sp-ring{fill:none;stroke:#C98A2B;stroke-width:3;stroke-dasharray:340;stroke-dashoffset:340;
    animation:spDraw 1.8s ease-out .2s forwards;}
  #splash .sp-disc{fill:#C98A2B;opacity:0;transform-origin:60px 60px;transform:scale(.6);
    animation:spPop .7s cubic-bezier(.2,1.4,.4,1) 1.9s forwards;}
  #splash .sp-s{fill:none;stroke:#FAF5E9;stroke-width:7;stroke-linecap:round;stroke-linejoin:round;
    stroke-dasharray:140;stroke-dashoffset:140;animation:spDraw 1.3s ease-in-out 1.3s forwards;}
  #splash .sp-name{font-family:Georgia,"Times New Roman",serif;font-weight:700;font-size:34px;letter-spacing:.14em;color:#FAF5E9;
    margin-top:26px;opacity:0;transform:translateY(10px);animation:spUp .8s ease-out 2.6s forwards;}
  #splash .sp-tag{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:#C98A2B;margin-top:8px;
    opacity:0;animation:spUp .8s ease-out 3.1s forwards;}
  #splash .sp-bar{width:180px;height:3px;border-radius:2px;background:rgba(250,245,233,.15);margin-top:34px;overflow:hidden;}
  #splash .sp-bar i{display:block;height:100%;width:0;background:#C98A2B;animation:spBar 5s linear forwards;}
  @keyframes spDraw{to{stroke-dashoffset:0;}}
  @keyframes spPop{to{opacity:1;transform:scale(1);}}
  @keyframes spUp{to{opacity:1;transform:translateY(0);}}
  @keyframes spBar{to{width:100%;}}
  @media print{#splash{display:none !important;}}

  .loading-screen{min-height:100vh;display:flex;align-items:center;justify-content:center;color:var(--ink-soft);}

  @media (max-width:880px){
    .shell{flex-direction:column;}
    .sidebar{width:100%;display:flex;overflow-x:auto;}
    .sidebar .navsep{margin-top:0;border-top:none;padding-top:0;}
    .billing-shell{flex-direction:column;}
    .receipt-pane{position:static;width:100%;}
    .stat-grid{grid-template-columns:repeat(2,1fr);}
    .topbar{padding:12px 14px;}
    .main{padding:18px 14px;}
  }
</style>
</head>
<body>

<div id="splash" aria-hidden="true">
  <svg viewBox="0 0 120 120">
    <circle class="sp-disc" cx="60" cy="60" r="52"/>
    <circle class="sp-ring" cx="60" cy="60" r="52"/>
    <path class="sp-s" d="M78 40 C70 30 44 31 44 45 C44 60 77 55 77 72 C77 88 49 89 40 77"/>
  </svg>
  <div class="sp-name">STOREBILL</div>
  <div class="sp-tag">Stock &amp; Billing</div>
  <div class="sp-bar"><i></i></div>
</div>

<div id="app"></div>

<div id="printArea" class="print-only"></div>

<script>
/* =========================================================
   STOREBILL — stock & billing app with CLOUD SYNC (v2)

   What changed in v2 (fixes "second product not saved / other devices
   not updating"):
   • Every product, labor account and bill is saved as its OWN record
     in Firebase, so one device can never overwrite another device's items.
   • Stock is reduced by writing only the quantity of the products sold.
   • The app re-checks the cloud every 8 seconds, so all devices stay in sync.
   • If a save fails you now see a clear red message — it never says "saved"
     when the cloud did not accept the data.
   • Old data (the list format) is converted automatically on first load.
   ========================================================= */

const CLOUD_DB_URL = 'https://store-bill-6edce-default-rtdb.asia-southeast1.firebasedatabase.app';
const SYNC_INTERVAL_MS = 8000;

const UNIT_TO_BASE = {kg:1, g:0.001, l:1, ml:0.001, piece:1};
const UNITS_FOR_TYPE = {WEIGHT:['kg','g'], VOLUME:['l','ml'], COUNT:['piece']};
const BASE_UNIT_LABEL = {WEIGHT:'kg', VOLUME:'l', COUNT:'piece'};

const ITEMS_PER_PAGE = 10;   // maximum products on one printed page

const PAPERS = {
  '80mm': { label:'Thermal roll 80mm', width:'72mm', pageW:80, margin:3, thermal:true },
  '58mm': { label:'Thermal roll 58mm', width:'50mm', pageW:58, margin:3, thermal:true },
  'A4':   { label:'A4 sheet',          width:'95mm', margin:12, thermal:false },
};
const MM_PER_PX = 25.4 / 96;

let state = {
  loaded: false,
  config: null,
  products: [],
  labor: [],
  bills: [],
  session: null,
  view: 'overview',
  cart: [],
  activeProduct: null,
  message: null,
  error: null,
};

let cloudFailed = false;
let cloudErrorText = '';

// ---------- local backup helpers ----------
const STORAGE_PREFIX = 'storebill:';
function localGet(key) {
  try { const raw = localStorage.getItem(STORAGE_PREFIX + key); return raw ? JSON.parse(raw) : null; }
  catch (e) { return null; }
}
function localSet(key, value) {
  try { localStorage.setItem(STORAGE_PREFIX + key, JSON.stringify(value)); } catch (e) {}
}

function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2,7); }

// ---------- cloud (Firebase REST) ----------
async function cloudRequest(path, method, body) {
  const opts = { method: method || 'GET', cache: 'no-store' };
  if (body !== undefined) { opts.headers = { 'Content-Type': 'application/json' }; opts.body = JSON.stringify(body); }
  const res = await fetch(`${CLOUD_DB_URL}/storebill/${path}.json`, opts);
  if (!res.ok) {
    let hint = '';
    if (res.status === 401 || res.status === 403) hint = ' — Firebase rules are blocking access (set .read and .write to true in Realtime Database → Rules)';
    if (res.status === 404) hint = ' — database URL not found, check CLOUD_DB_URL';
    throw new Error('HTTP ' + res.status + hint);
  }
  const text = await res.text();
  if (!text) return null;
  try { return JSON.parse(text); }
  catch (e) { throw new Error('The database replied with something unexpected — check CLOUD_DB_URL and the Firebase rules.'); }
}
function noteCloudError(e) {
  cloudFailed = true;
  cloudErrorText = String(e && e.message ? e.message : e);
}

// Turn the stored object {id: record} into a list. Old data (a plain list) is converted once.
async function loadCollection(name) {
  if (!CLOUD_DB_URL) return localGet(name) || [];
  try {
    let data = await cloudRequest(name, 'GET');
    if (Array.isArray(data)) {                       // legacy format -> convert to per-record format
      const map = {};
      data.forEach(it => { if (it && typeof it === 'object') { if (!it.id) it.id = uid(); map[it.id] = it; } });
      if (Object.keys(map).length) await cloudRequest(name, 'PUT', map);
      data = Object.keys(map).length ? map : null;
    }
    const list = data ? Object.entries(data)
      .filter(([k, v]) => v && typeof v === 'object')
      .map(([k, v]) => Object.assign({}, v, { id: v.id || k })) : [];
    localSet(name, list);
    return list;
  } catch (e) {
    noteCloudError(e);
    return localGet(name) || [];
  }
}
async function loadConfig() {
  if (!CLOUD_DB_URL) return localGet('config');
  try {
    const data = await cloudRequest('config', 'GET');
    if (data) localSet('config', data);
    return data;
  } catch (e) {
    noteCloudError(e);
    return localGet('config');
  }
}
async function loadAll() {
  cloudFailed = false;
  state.config = await loadConfig();
  state.products = await loadCollection('products');
  state.labor = await loadCollection('labor');
  state.bills = await loadCollection('bills');
  state.loaded = true;
}
// Pull newest data. Returns true if anything changed.
async function refreshFromCloud() {
  if (!CLOUD_DB_URL) return false;
  const snap = () => JSON.stringify([state.config, state.products, state.labor, state.bills]);
  const before = snap();
  cloudFailed = false;
  const cfg = await loadConfig(); if (cfg) state.config = cfg;
  state.products = await loadCollection('products');
  state.labor = await loadCollection('labor');
  state.bills = await loadCollection('bills');
  return snap() !== before;
}

// ---------- saving (each returns true only if the cloud accepted it) ----------
async function saveRecord(name, rec) {
  localSet(name, state[name]);
  if (!CLOUD_DB_URL) return true;
  try { await cloudRequest(`${name}/${rec.id}`, 'PUT', rec); cloudFailed = false; return true; }
  catch (e) {
    noteCloudError(e);
    state.error = 'NOT saved to the cloud (' + cloudErrorText + '). Other devices will not see this change.';
    return false;
  }
}
async function deleteRecord(name, id) {
  localSet(name, state[name]);
  if (!CLOUD_DB_URL) return true;
  try { await cloudRequest(`${name}/${id}`, 'DELETE'); cloudFailed = false; return true; }
  catch (e) {
    noteCloudError(e);
    state.error = 'NOT deleted from the cloud (' + cloudErrorText + ').';
    return false;
  }
}
async function clearCollection(name) {
  localSet(name, []);
  if (!CLOUD_DB_URL) return true;
  try { await cloudRequest(name, 'DELETE'); cloudFailed = false; return true; }
  catch (e) {
    noteCloudError(e);
    state.error = 'NOT cleared in the cloud (' + cloudErrorText + ').';
    return false;
  }
}
async function saveConfig(cfg) {
  localSet('config', cfg);
  if (!CLOUD_DB_URL) return true;
  try { await cloudRequest('config', 'PUT', cfg); cloudFailed = false; return true; }
  catch (e) {
    noteCloudError(e);
    state.error = 'NOT saved to the cloud (' + cloudErrorText + ').';
    return false;
  }
}

function fmtMoney(n) { return '₹' + Number(n).toFixed(2); }

function baseUnitFor(mt) { return BASE_UNIT_LABEL[mt]; }
function allowedUnitsFor(mt) { return UNITS_FOR_TYPE[mt]; }
function toBaseQty(product, amount, unit) {
  const factor = UNIT_TO_BASE[unit] / UNIT_TO_BASE[product.baseUnit];
  return Math.round(amount * factor * 1000) / 1000;
}
function priceFor(product, amount, unit) {
  return Math.round(toBaseQty(product, amount, unit) * product.pricePerBase * 100) / 100;
}
function inStock(p) { return !p.manuallyDisabled && p.quantityInStock > 0; }
function isLowStock(p) { return inStock(p) && p.lowStockThreshold > 0 && p.quantityInStock <= p.lowStockThreshold; }
function stockLabel(p) {
  if (p.manuallyDisabled || p.quantityInStock <= 0) return 'Out of stock';
  if (isLowStock(p)) return 'Low stock';
  return 'In stock';
}
function displayQty(p) {
  if (p.measurementType === 'COUNT') return `${Math.trunc(p.quantityInStock)} piece`;
  return `${p.quantityInStock} ${p.baseUnit}`;
}

function esc(s) { const d=document.createElement('div'); d.textContent = s==null?'':s; return d.innerHTML; }

// ---------- sync badge ----------
function syncBadgeInfo() {
  if (!CLOUD_DB_URL) return { cls:'local', text:'● This device only' };
  if (cloudFailed) return { cls:'bad', text:'● Offline — not syncing' };
  return { cls:'ok', text:'● Synced' };
}
function updateSyncBadge() {
  const el = document.getElementById('syncBadge');
  if (!el) return;
  const i = syncBadgeInfo();
  el.className = 'sync ' + i.cls;
  el.textContent = i.text;
}

// ---------- render ----------
function render() {
  const app = document.getElementById('app');
  if (!state.loaded) { app.innerHTML = `<div class="loading-screen">Loading StoreBill…</div>`; return; }
  if (!state.config && CLOUD_DB_URL && cloudFailed) {
    app.innerHTML = `
    <div class="auth-wrap"><div class="card auth-card">
      <h1>Cannot reach the database</h1>
      <div class="sub">StoreBill could not connect to the cloud database. Check your internet connection and the CLOUD_DB_URL (Firebase link) in the code, then try again.</div>
      <div class="errbox" style="word-break:break-word;">Details: ${esc(cloudErrorText)}</div>
      <button class="btn btn-primary" style="width:100%;justify-content:center;" id="retryCloudBtn">Try again</button>
    </div></div>`;
    document.getElementById('retryCloudBtn').addEventListener('click', async () => {
      state.loaded = false; render(); await loadAll(); render();
    });
    return;
  }
  if (!state.config) { app.innerHTML = renderSetup(); attachSetupHandlers(); return; }
  if (!state.session) { app.innerHTML = renderLogin(); attachLoginHandlers(); return; }
  app.innerHTML = renderApp();
  attachAppHandlers();
}

