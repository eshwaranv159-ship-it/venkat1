      <div class="helptext" style="text-align:center;margin-top:8px;">Print Bill opens your device's print dialog — pick your connected printer there.</div>
    </div>
  </div>
  ${renderAddToCartModal()}`;
}
function priceForCartLine(item) {
  const baseQty = item.quantity * (UNIT_TO_BASE[item.unit] / UNIT_TO_BASE[item.baseUnit]);
  return baseQty * item.pricePerBase;
}
function renderAddToCartModal() {
  if (!state._cartModalOpen || !state.activeProduct) return '';
  const p = state.activeProduct;
  const units = allowedUnitsFor(p.measurementType);
  return `
  <div class="modal-backdrop open" id="cartModalBackdrop">
    <div class="modal">
      <h3>${esc(p.name)}</h3>
      <div class="field"><label>Quantity</label>
