      ? (cloudFailed ? '⚠ Cloud database is not reachable right now: ' + esc(cloudErrorText)
                     : '✓ Connected — products, labor accounts and bills are saved permanently and refresh automatically on every device every ' + (SYNC_INTERVAL_MS/1000) + ' seconds.')
      : '⚠ Not connected. Data is saved on this device only. Add your Firebase URL to CLOUD_DB_URL in the code to share data across devices.'}</p>
  </div>`;
}
function currentPaper() { return (state.config && state.config.paper && PAPERS[state.config.paper]) ? state.config.paper : '80mm'; }
function attachSettingsHandlers() {
  document.getElementById('st-paper')?.addEventListener('change', async (e) => {
    state.error = null; state.message = null;
    state.config.paper = e.target.value;
    const ok = await saveConfig(state.config);
    if (ok) state.message = 'Printer paper set to ' + PAPERS[state.config.paper].label + '.';
    render();
  });
  document.getElementById('settingsForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    state.error = null; state.message = null;
    const newUsername = document.getElementById('st-username').value.trim();
    const newPassword = document.getElementById('st-newpassword').value;
    const currentPassword = document.getElementById('st-currentpassword').value;
    if (currentPassword !== state.config.adminPassword) {
      state.error = 'Current password is incorrect.'; render(); return;
    }
    if (!newUsername) { state.error = 'Username cannot be empty.'; render(); return; }
    if (newPassword && newPassword.length < 4) { state.error = 'New password must be at least 4 characters.'; render(); return; }
    state.config.adminUsername = newUsername;
    if (newPassword) state.config.adminPassword = newPassword;
    const ok = await saveConfig(state.config);
    if (ok) { state.session.username = newUsername; state.message = 'Account settings updated.'; }
    render();
  });
}

// ---------- event wiring ----------
function attachAppHandlers() {
  document.getElementById('logoutBtn')?.addEventListener('click', () => {
    state.session = null; state.cart = []; state.error = null; state.message = null; render();
  });
  document.querySelectorAll('[data-nav]').forEach(el => el.addEventListener('click', async () => {
    state.view = el.dataset.nav; state.message = null; state.error = null;
    await refreshFromCloud();
    render();
  }));
  document.getElementById('refreshBtn')?.addEventListener('click', async () => {
    await refreshFromCloud(); render();
  });

  if (state.view === 'products' || (state.session.role==='ADMIN' && document.getElementById('addProductBtn'))) attachProductHandlers();
  if (state.view === 'labor') attachLaborHandlers();
  if (state.view === 'bills') attachBillsHandlers();
  if (state.view === 'settings') attachSettingsHandlers();
  if (state.view === 'billing') attachBillingHandlers();
}

function attachProductHandlers() {
  document.getElementById('productSearch')?.addEventListener('input', (e) => {
    state._productQuery = e.target.value; render();
    const el = document.getElementById('productSearch');
    el.focus(); el.selectionStart = el.selectionEnd = el.value.length;
  });
  document.getElementById('addProductBtn')?.addEventListener('click', () => { state._editingProduct = null; state._productModalOpen = true; render(); });
  document.querySelectorAll('[data-edit-product]').forEach(el => el.addEventListener('click', () => {
    state._editingProduct = state.products.find(p => p.id === el.dataset.editProduct);
    state._productModalOpen = true; render();
  }));
  document.querySelectorAll('[data-toggle-product]').forEach(el => el.addEventListener('click', async () => {
    const p = state.products.find(p => p.id === el.dataset.toggleProduct);
    if (!p) return;
    state.error = null; state.message = null;
    p.manuallyDisabled = !p.manuallyDisabled;
    await saveRecord('products', p);
    render();
  }));
  document.querySelectorAll('[data-delete-product]').forEach(el => el.addEventListener('click', async () => {
    if (!confirm('Delete this product? This cannot be undone.')) return;
    const id = el.dataset.deleteProduct;
    state.error = null; state.message = null;
    state.products = state.products.filter(p => p.id !== id);
    const ok = await deleteRecord('products', id);
    if (ok) state.message = 'Product removed.';
    render();
  }));
  document.getElementById('cancelProductModal')?.addEventListener('click', () => { state._productModalOpen = false; render(); });
  document.getElementById('productForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = document.getElementById('pf-name').value.trim();
    const measurementType = document.getElementById('pf-mtype').value;
    const price = parseFloat(document.getElementById('pf-price').value);
    const qty = parseFloat(document.getElementById('pf-qty').value);
    if (!name || isNaN(price) || price < 0 || isNaN(qty) || qty < 0) return;
    const btn = document.getElementById('saveProductBtn');
    if (btn) { btn.disabled = true; btn.textContent = 'Saving…'; }

    const fields = {
      name, category: document.getElementById('pf-category').value.trim(), measurementType,
      baseUnit: baseUnitFor(measurementType), pricePerBase: price, quantityInStock: qty,
      lowStockThreshold: parseFloat(document.getElementById('pf-low').value) || 0,
      manuallyDisabled: document.getElementById('pf-disabled').checked,
    };
    let rec;
    if (state._editingProduct) {
      rec = state.products.find(p => p.id === state._editingProduct.id);
      if (!rec) { rec = state._editingProduct; state.products.push(rec); }
      Object.assign(rec, fields);
    } else {
      rec = Object.assign({ id: uid() }, fields);
      state.products.push(rec);
    }
    state.error = null; state.message = null;
    const ok = await saveRecord('products', rec);
    if (ok) state.message = `'${name}' saved to the cloud.`;
    state._productModalOpen = false; state._editingProduct = null;
    render();
  });
}

function attachLaborHandlers() {
  document.getElementById('addLaborBtn')?.addEventListener('click', () => { state._laborModalOpen = true; render(); });
  document.getElementById('cancelLaborModal')?.addEventListener('click', () => { state._laborModalOpen = false; render(); });
  document.querySelectorAll('[data-toggle-labor]').forEach(el => el.addEventListener('click', async () => {
    const l = state.labor.find(l => l.id === el.dataset.toggleLabor);
    if (!l) return;
    state.error = null; state.message = null;
    l.active = !l.active;
    await saveRecord('labor', l);
    render();
  }));
  document.querySelectorAll('[data-delete-labor]').forEach(el => el.addEventListener('click', async () => {
    if (!confirm('Delete this labor account? This cannot be undone.')) return;
    const id = el.dataset.deleteLabor;
    state.error = null; state.message = null;
    state.labor = state.labor.filter(l => l.id !== id);
    const ok = await deleteRecord('labor', id);
    if (ok) state.message = 'Labor account removed.';
    render();
  }));
  document.getElementById('laborForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const username = document.getElementById('lf-username').value.trim();
    const password = document.getElementById('lf-password').value;
    if (!username || password.length < 4) return;
    await refreshFromCloud();
    if (state.labor.some(l => l.username === username) || username === state.config.adminUsername) {
      state.error = 'That username is already taken.'; render(); return;
    }
    const rec = { id: uid(), username, password, phone: document.getElementById('lf-phone').value.trim(), active: true };
    state.labor.push(rec);
    state.error = null; state.message = null;
    const ok = await saveRecord('labor', rec);
    if (ok) state.message = 'Labor account created.';
    state._laborModalOpen = false;
    render();
  });
}

function attachBillsHandlers() {
  document.querySelectorAll('[data-reprint]').forEach(el => el.addEventListener('click', () => {
    const bill = state.bills.find(b => b.id === el.dataset.reprint);
    if (bill) printBill(bill);
  }));
  document.querySelectorAll('[data-delete-bill]').forEach(el => el.addEventListener('click', async () => {
    if (!confirm('Delete this bill from history? This cannot be undone (stock already sold is not restored).')) return;
    const id = el.dataset.deleteBill;
    state.error = null; state.message = null;
    state.bills = state.bills.filter(b => b.id !== id);
    const ok = await deleteRecord('bills', id);
    if (ok) state.message = 'Bill deleted from history.';
    render();
  }));
  document.getElementById('clearAllBillsBtn')?.addEventListener('click', async () => {
    if (!confirm('Clear ALL bill history? This cannot be undone.')) return;
    state.error = null; state.message = null;
    state.bills = [];
    const ok = await clearCollection('bills');
    if (ok) state.message = 'Bill history cleared.';
    render();
  });
}

function attachBillingHandlers() {
  document.getElementById('billingSearch')?.addEventListener('input', (e) => {
    state._billingQuery = e.target.value; render();
    const el = document.getElementById('billingSearch'); el.focus(); el.selectionStart = el.selectionEnd = el.value.length;
  });
  document.getElementById('customerName')?.addEventListener('input', (e) => { state._customerName = e.target.value; });
  document.querySelectorAll('[data-tile]').forEach(el => el.addEventListener('click', () => {
    state.activeProduct = state.products.find(p => p.id === el.dataset.tile);
    state._cartModalOpen = true; render();
  }));
  document.getElementById('cancelCartModal')?.addEventListener('click', () => { state._cartModalOpen = false; state.activeProduct = null; render(); });
  document.getElementById('confirmAddToCart')?.addEventListener('click', () => {
    const qty = parseFloat(document.getElementById('cm-qty').value);
    const unit = document.getElementById('cm-unit').value;
    if (!qty || qty <= 0) return;
    const p = state.activeProduct;
    state.cart.push({ productId: p.id, name: p.name, quantity: qty, unit, pricePerBase: p.pricePerBase, baseUnit: p.baseUnit, measurementType: p.measurementType });
    state._cartModalOpen = false; state.activeProduct = null; render();
  });
  document.querySelectorAll('[data-remove-line]').forEach(el => el.addEventListener('click', () => {
    state.cart.splice(parseInt(el.dataset.removeLine), 1); render();
  }));
  document.getElementById('printBillBtn')?.addEventListener('click', handlePrintBill);
  document.getElementById('newBillBtn')?.addEventListener('click', () => {
    state.cart = []; state._customerName = ''; state.error = null; render();
  });
}

let printing = false;
async function handlePrintBill() {
  if (printing) return;
  state.error = null;
  if (!state.cart.length) { state.error = 'Add at least one product first.'; render(); return; }
  printing = true;
  const btn = document.getElementById('printBillBtn');
  if (btn) { btn.disabled = true; btn.textContent = 'Saving…'; }

  try {
    // 1. Read the latest stock straight from the cloud
    cloudFailed = false;
    const fresh = await loadCollection('products');
    if (CLOUD_DB_URL && cloudFailed) {
      state.error = 'Cannot reach the cloud database (' + cloudErrorText + '), so the bill was NOT saved and stock was not changed. Check the internet and try again.';
      render(); return;
    }

    // 2. Check stock (adds up the same product if it is on several lines)
    const need = {};
    for (const item of state.cart) {
      const p = fresh.find(p => p.id === item.productId);
      if (!p) { state.error = `${item.name} no longer exists.`; render(); return; }
      if (p.manuallyDisabled) { state.error = `${p.name} is marked out of stock by Admin.`; render(); return; }
      need[p.id] = (need[p.id] || 0) + toBaseQty({baseUnit:p.baseUnit}, item.quantity, item.unit);
      if (need[p.id] > p.quantityInStock) {
        state.error = `Not enough ${p.name} in stock (have ${displayQty(p)}).`; render(); return;
      }
    }

    // 3. Build the bill and reduce stock
    let total = 0;
    const billItems = [];
    for (const item of state.cart) {
      const p = fresh.find(p => p.id === item.productId);
      const baseQty = toBaseQty({baseUnit:p.baseUnit}, item.quantity, item.unit);
      const lineTotal = priceFor(p, item.quantity, item.unit);
      total += lineTotal;
      p.quantityInStock = Math.round((p.quantityInStock - baseQty) * 1000) / 1000;
      billItems.push({ productName: p.name, quantity: item.quantity, unit: item.unit, unitPricePerBase: p.pricePerBase, lineTotal });
    }

    // 4. Write ONLY the changed quantities (other fields/devices are untouched)
    if (CLOUD_DB_URL) {
      for (const id of Object.keys(need)) {
        const p = fresh.find(x => x.id === id);
        await cloudRequest(`products/${id}/quantityInStock`, 'PUT', p.quantityInStock);
      }
    }
    state.products = fresh;
    localSet('products', state.products);

    // 5. Save the bill as its own record
    const bills = await loadCollection('bills');
    const maxNo = bills.reduce((m, b) => Math.max(m, parseInt(String(b.billNumber).replace(/\D/g, '')) || 0), 0);
    const bill = {
      id: uid(),
      billNumber: 'BILL-' + String(maxNo + 1).padStart(6, '0'),
      customerName: (state._customerName || '').trim() || 'daily customer',
      billedBy: state.session.username,
      totalAmount: Math.round(total * 100) / 100,
      createdAt: Date.now(),
      items: billItems,
    };
    state.bills = bills; state.bills.push(bill);
    const billSaved = await saveRecord('bills', bill);

    state.cart = []; state._customerName = '';
    if (billSaved) state.error = null;
    render();
    printBill(bill);
  } catch (e) {
    noteCloudError(e);
    state.error = 'Saving the bill failed (' + cloudErrorText + '). Please check the stock and bill history before trying again.';
    render();
  } finally {
    printing = false;
  }
}

function itemHtml(i) {
  return `
    <tr><td colspan="2" class="item-name">${esc(i.productName)}</td></tr>
    <tr><td>${i.quantity} ${i.unit} × ${fmtMoney(i.unitPricePerBase)}</td><td class="r">${fmtMoney(i.lineTotal)}</td></tr>`;
}

function printBill(bill) {
  const area = document.getElementById('printArea');
  const paper = PAPERS[currentPaper()];
  const totalItems = bill.items.length;

  const pages = [];
  for (let i = 0; i < totalItems; i += ITEMS_PER_PAGE) pages.push(bill.items.slice(i, i + ITEMS_PER_PAGE));
  if (!pages.length) pages.push([]);
  const totalPages = pages.length;

  area.style.width = paper.width;
  area.innerHTML = pages.map((items, idx) => {
    const isLast = idx === totalPages - 1;
    const pageSubtotal = items.reduce((s, i) => s + i.lineTotal, 0);
    const tailCount = Math.min(2, items.length);
    const body = items.slice(0, items.length - tailCount);
    const tail = items.slice(items.length - tailCount);

    const footer = isLast
      ? `<div class="count-pill"><span>Total items</span><span>${totalItems}</span></div>
         <table><tr class="grand"><td>TOTAL</td><td class="r">${fmtMoney(bill.totalAmount)}</td></tr></table>
         <hr>
         <div class="center">Thank you — visit again!</div>`
      : `<table><tr><td>Page subtotal</td><td class="r">${fmtMoney(pageSubtotal)}</td></tr></table>
         <hr>
         <div class="center">Continued on next page…</div>`;

    return `
    <div class="receipt-page">
      <div class="shop">StoreBill</div>
      <div class="sub">Kirana &amp; General Store</div>
      <div class="sub">Sales Receipt${totalPages > 1 ? ` — Page ${idx + 1} of ${totalPages}` : ''}</div>
      <hr>
      <table>
        <tr><td>Bill No.</td><td class="r">${esc(bill.billNumber)}</td></tr>
        <tr><td>Date</td><td class="r">${new Date(bill.createdAt).toLocaleString()}</td></tr>
        <tr><td>Customer</td><td class="r">${esc(bill.customerName)}</td></tr>
        <tr><td>Billed by</td><td class="r">${esc(bill.billedBy)}</td></tr>
      </table>
      <div class="count-pill"><span>${totalPages > 1 ? 'Items on this page' : 'Total items'}</span><span>${totalPages > 1 ? items.length : totalItems}</span></div>
      <hr>
      ${body.length ? `<table>${body.map(itemHtml).join('')}</table>` : ''}
      <div class="keep-together">
        <table>${tail.map(itemHtml).join('')}</table>
        <hr>
        ${footer}
      </div>
    </div>`;
  }).join('');

  setPrintPageStyle(area, paper);
  setTimeout(() => window.print(), 150);
}

function setPrintPageStyle(area, paper) {
  let css;
  if (paper.thermal) {
    const prev = area.style.cssText;
    area.style.cssText += ';display:block;position:absolute;left:-9999px;top:0;visibility:hidden;';
    let maxPx = 0;
    area.querySelectorAll('.receipt-page').forEach(pg => { maxPx = Math.max(maxPx, pg.offsetHeight); });
    area.style.cssText = prev;
    const heightMm = Math.ceil(maxPx * MM_PER_PX + paper.margin * 2 + 4);
    css = `@page{size:${paper.pageW}mm ${heightMm}mm;margin:${paper.margin}mm;}`;
  } else {
    css = `@page{size:A4;margin:${paper.margin}mm;}`;
  }
  let tag = document.getElementById('pageStyle');
  if (!tag) { tag = document.createElement('style'); tag.id = 'pageStyle'; document.head.appendChild(tag); }
  tag.textContent = css;
}

// ---------- automatic sync between devices ----------
let syncBusy = false;
let pendingRender = false;
function userIsBusy() {
  const a = document.activeElement;
  const typing = a && (a.tagName === 'INPUT' || a.tagName === 'SELECT' || a.tagName === 'TEXTAREA');
  return typing || state._productModalOpen || state._laborModalOpen || state._cartModalOpen || printing;
}
setInterval(async () => {
  if (!CLOUD_DB_URL || !state.loaded || !state.session || syncBusy || document.hidden || printing) return;
  syncBusy = true;
  try {
    if (await refreshFromCloud()) pendingRender = true;
    updateSyncBadge();
    if (pendingRender && !userIsBusy()) { pendingRender = false; render(); }
  } catch (e) {
    /* ignore, next tick retries */
  } finally {
    syncBusy = false;
  }
}, SYNC_INTERVAL_MS);

// Refresh immediately when the user comes back to the tab / app
document.addEventListener('visibilitychange', async () => {
  if (document.hidden || !CLOUD_DB_URL || !state.session || syncBusy || printing) return;
  syncBusy = true;
  try {
    if (await refreshFromCloud()) { if (!userIsBusy()) render(); else pendingRender = true; }
    updateSyncBadge();
  } finally { syncBusy = false; }
});

// ---------- boot ----------
(async function boot() {
  render();
  await loadAll();
  render();
  setTimeout(() => {
    const sp = document.getElementById('splash');
    if (!sp) return;
    sp.classList.add('hide');
    setTimeout(() => sp.remove(), 700);
  }, 5000);
})();
</script>
