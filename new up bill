      <button class="btn btn-primary" style="width:100%;justify-content:center;" type="submit">Create Admin account</button>
    </form>
  </div></div>`;
}
function attachSetupHandlers() {
  document.getElementById('setupForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const username = document.getElementById('su-username').value.trim();
    const password = document.getElementById('su-password').value;
    if (!username || password.length < 4) { state.error = 'Enter a username and a password (4+ characters).'; render(); return; }
    // Make sure an Admin was not created meanwhile on another device
    const existing = await loadConfig();
    if (existing) { state.config = existing; state.error = 'An Admin account already exists — please sign in.'; render(); return; }
    const cfg = { adminUsername: username, adminPassword: password };
    state.error = null;
    const ok = await saveConfig(cfg);
    if (!ok) { localSet('config', null); render(); return; }   // do not continue unless the cloud has it
    state.config = cfg;
    state.session = { username, role: 'ADMIN' };
    state.error = null;
    render();
  });
}

// ----- login -----
function renderLogin() {
  return `
  <div class="auth-wrap"><div class="card auth-card">
    <span class="mark" style="display:inline-flex;align-items:center;justify-content:center;background:var(--turmeric);
      color:#fff;border-radius:50%;width:44px;height:44px;font-family:Georgia,serif;font-weight:700;">S</span>
    <h1>StoreBill</h1>
    <div class="sub">Sign in to open the counter</div>
    ${state.error ? `<div class="errbox">${esc(state.error)}</div>` : ''}
    <form id="loginForm">
      <div class="field"><label>Username</label><input type="text" id="li-username" required></div>
      <div class="field"><label>Password</label><input type="password" id="li-password" required></div>
      <button class="btn btn-primary" style="width:100%;justify-content:center;" type="submit">Sign in</button>
    </form>
  </div></div>`;
}
function attachLoginHandlers() {
  document.getElementById('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const username = document.getElementById('li-username').value.trim();
    const password = document.getElementById('li-password').value;
    await refreshFromCloud();
    if (username === state.config.adminUsername && password === state.config.adminPassword) {
      state.session = { username, role: 'ADMIN' }; state.error = null; state.view = 'overview'; render(); return;
    }
    const labor = state.labor.find(l => l.username === username && l.password === password);
    if (labor) {
      if (!labor.active) { state.error = 'This account has been disabled by the Admin.'; render(); return; }
      state.session = { username, role: 'LABOR' }; state.error = null; state.view = 'billing'; render(); return;
    }
    state.error = 'Incorrect username or password.'; render();
  });
}

// ----- main app shell -----
function renderApp() {
  if (state.session.role === 'LABOR') {
    state.view = 'billing';
    return renderTopbar() + renderBillingScreen();
  }
  const nav = [
    ['overview','Overview'], ['products','Products & Stock'], ['labor','Labor Accounts'],
    ['bills','Bill History'], ['settings','Account Settings'], ['billing','Billing Counter'],
  ];
  const navHtml = nav.map(([key,label]) => `
    <button class="navlink ${state.view===key?'active':''} ${key==='billing'?'navsep':''}" data-nav="${key}">${label}${key==='billing'?' →':''}</button>
  `).join('');
  let content = '';
  if (state.view === 'overview') content = renderOverview();
  else if (state.view === 'products') content = renderProducts();
  else if (state.view === 'labor') content = renderLabor();
  else if (state.view === 'bills') content = renderBills();
  else if (state.view === 'settings') content = renderSettings();
  else if (state.view === 'billing') content = renderBillingScreen(true);

  return renderTopbar() + `
  <div class="shell">
    <aside class="sidebar">${navHtml}</aside>
    <main class="main">${content}</main>
  </div>`;
}

function msgBanner() {
  let html = '';
  if (state.message) html += `<div class="msg">${esc(state.message)}</div>`;
  if (state.error) html += `<div class="msg err">${esc(state.error)}</div>`;
  return html;
}

