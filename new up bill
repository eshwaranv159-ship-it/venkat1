// ----- billing counter (used by both Labor and Admin) -----
function renderBillingScreen(isAdmin) {
  const q = (state._billingQuery || '').toLowerCase();
  const list = state.products.filter(p => !q || p.name.toLowerCase().includes(q) || (p.category||'').toLowerCase().includes(q));
  const cartTotal = state.cart.reduce((s,i) => s + priceForCartLine(i), 0);

  const tiles = list.length ? list.map(p => `
    <div class="product-tile ${!inStock(p)?'disabled':''}" ${inStock(p)?`data-tile="${esc(p.id)}"`:''}>
