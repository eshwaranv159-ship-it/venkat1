      <div class="cat">${esc(p.category)||'&nbsp;'}</div>
      <div class="price">${fmtMoney(p.pricePerBase)} / ${p.baseUnit}</div>
      <div class="stock">${displayQty(p)} in stock</div>
    </div>`).join('') : `<div class="receipt-empty">No products ${q?'match your search':'yet — ask the Admin to add some'}.</div>`;

  const lines = state.cart.length ? state.cart.map((item, idx) => `
    <div class="receipt-line">
      <div><div class="rl-name">${esc(item.name)}</div><div class="rl-meta">${item.quantity} ${item.unit} × ${fmtMoney(item.pricePerBase)}/${item.baseUnit}</div></div>
      <div>${fmtMoney(priceForCartLine(item))} <span class="rl-remove" data-remove-line="${idx}">✕</span></div>
    </div>`).join('') : `<div class="receipt-empty">No items added yet. Tap a product to add it.</div>`;

  return `
  <div class="billing-shell">
    <div class="product-pane">
      <div class="search-row" style="display:flex;gap:8px;">
        <input type="text" id="billingSearch" placeholder="Search products by name or category..." value="${esc(state._billingQuery||'')}">
        ${CLOUD_DB_URL ? `<button class="btn btn-outline" id="refreshBtn" title="Load the latest products from the cloud">⟳ Refresh</button>` : ''}
      </div>
      <div class="product-grid">${tiles}</div>
    </div>
    <div class="receipt-pane">
      <div class="receipt">
        <h2>StoreBill</h2>
        <div class="sub-center">Sales Receipt</div>
        <div class="cust-field"><label style="font-size:11.5px;font-weight:700;">Customer name</label>
          <input type="text" id="customerName" placeholder="Walk-in customer" value="${esc(state._customerName||'')}"></div>
        <div class="receipt-lines">${lines}</div>
        <div class="receipt-total"><span>Total</span><span class="mono">${fmtMoney(cartTotal)}</span></div>
        ${state.error ? `<div class="errbox" style="text-align:center;font-weight:700;">${esc(state.error)}</div>` : ''}
